import jax
import jax.numpy as jnp


def masked_lower_median(values: jnp.ndarray, mask: jnp.ndarray):
    """Compute a lower median over valid values only.

    This avoids dynamic-shape indexing and is friendly to JAX/XLA.

    If values = [1, 3, 5, 7], lower median = 3.
    """
    valid_count = jnp.sum(mask.astype(jnp.int32))

    safe_values = jnp.where(mask, values, jnp.inf)
    sorted_values = jnp.sort(safe_values)

    median_index = jnp.maximum((valid_count - 1) // 2, 0)
    median_value = sorted_values[median_index]

    return median_value, valid_count


def least_q_decision(
    q_current,
    q_history: jnp.ndarray,
    valid_history: jnp.ndarray,
    active_slot_mask=None,
    episode_step: int,
    global_step: int,
    least_start_steps: int,
    min_ref_episodes: int,
    least_min_episode_steps: int,
):
    """LEAST-Q decision based only on Q-value median threshold."""
    step = jnp.minimum(
        jnp.array(episode_step, dtype=jnp.int32),
        q_history.shape[1] - 1,
    )

    q_column = q_history[:, step]
    valid_column = valid_history[:, step]

    threshold, valid_count = masked_lower_median(
        q_column,
        valid_column,
    )

    enough_history = valid_count >= min_ref_episodes
    after_start = global_step >= least_start_steps
    after_min_episode_step = episode_step >= least_min_episode_steps

    can_stop = jnp.logical_and(
        jnp.logical_and(after_start, enough_history),
        after_min_episode_step,
    )

    stop = jnp.logical_and(
        can_stop,
        q_current < threshold,
    )

    return stop, threshold, valid_count


def least_qloss_decision(
    q_current,
    loss_current,
    q_history: jnp.ndarray,
    loss_history: jnp.ndarray,
    valid_history: jnp.ndarray,
    episode_step: int,
    global_step: int,
    least_start_steps: int,
    min_ref_episodes: int,
    least_min_episode_steps: int,
    omega_clip_min: float = 0.2,
    omega_clip_max: float = 5.0,
):
    """LEAST-Q-loss decision.

    This implements the core Algorithm 1 stopping logic:

      epsilon_i = Median(B_Q[:, i])
      omega_i   = Median(B_G[:, i]) / L_i

    Complete rule:
      if epsilon_i >= 0:
          stop if q_current < omega_i * epsilon_i
      else:
          stop if q_current < epsilon_i / omega_i

    Interpretation:
      - high current loss means high learning potential
      - high learning potential makes stopping less likely
      - low current loss means familiar / already learned
      - low Q + low loss makes stopping more likely
    """
    step = jnp.minimum(
        jnp.array(episode_step, dtype=jnp.int32),
        q_history.shape[1] - 1,
    )

    q_column = q_history[:, step]
    loss_column = loss_history[:, step]
    valid_column = valid_history[:, step]

    if active_slot_mask is not None:
        valid_column = jnp.logical_and(valid_column, active_slot_mask)

    epsilon_i, valid_count = masked_lower_median(q_column, valid_column)
    median_loss_i, _ = masked_lower_median(loss_column, valid_column)

    safe_loss_current = jnp.maximum(loss_current, 1e-8)
    omega_i = median_loss_i / safe_loss_current
    omega_i = jnp.clip(omega_i, omega_clip_min, omega_clip_max)

    threshold = jnp.where(
        epsilon_i >= 0.0,
        omega_i * epsilon_i,
        epsilon_i / omega_i,
    )

    enough_history = valid_count >= min_ref_episodes
    after_start = global_step >= least_start_steps
    after_min_episode_step = episode_step >= least_min_episode_steps

    can_stop = jnp.logical_and(
        jnp.logical_and(after_start, enough_history),
        after_min_episode_step,
    )

    stop = jnp.logical_and(
        can_stop,
        q_current < threshold,
    )

    return stop, threshold, valid_count, epsilon_i, median_loss_i, omega_i


def compute_current_min_q(
    critic_apply,
    critic_params,
    obs,
    action,
):
    """Compute min(Q1, Q2) for one transition."""
    obs_batch = jnp.expand_dims(obs, axis=0)
    action_batch = jnp.expand_dims(action, axis=0)

    q1, q2 = critic_apply(
        critic_params,
        obs_batch,
        action_batch,
    )

    return jnp.minimum(q1[0], q2[0])


def compute_current_q_and_td_error(
    actor_apply,
    critic_apply,
    actor_params,
    critic_params,
    target_actor_params,
    target_critic_params,
    obs,
    action,
    reward,
    next_obs,
    done,
    key,
    gamma: float,
    policy_noise: float,
    noise_clip: float,
):
    """Compute current min-Q and absolute TD error for one transition.

    L_i is implemented as absolute TD error:

      L_i = | min(Q1, Q2)(s, a) - target |

    where target follows TD3-style target policy smoothing.
    """
    obs_batch = jnp.expand_dims(obs, axis=0)
    action_batch = jnp.expand_dims(action, axis=0)
    next_obs_batch = jnp.expand_dims(next_obs, axis=0)

    q1, q2 = critic_apply(
        critic_params,
        obs_batch,
        action_batch,
    )
    current_q = jnp.minimum(q1[0], q2[0])

    next_action = actor_apply(
        target_actor_params,
        next_obs_batch,
    )

    noise = jax.random.normal(key, next_action.shape) * policy_noise
    noise = jnp.clip(noise, -noise_clip, noise_clip)
    next_action = jnp.clip(next_action + noise, -1.0, 1.0)

    target_q1, target_q2 = critic_apply(
        target_critic_params,
        next_obs_batch,
        next_action,
    )
    target_q = jnp.minimum(target_q1[0], target_q2[0])

    td_target = reward + gamma * (1.0 - done) * target_q
    td_error = jnp.abs(current_q - jax.lax.stop_gradient(td_target))

    return current_q, td_error
